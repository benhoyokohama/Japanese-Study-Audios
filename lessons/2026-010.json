[
    {
        "id": 1,
        "start": 0.0,
        "end": 5.24,
        "jp": "たった3分なのに頭の中がすっきりします。",
        "cn": ""
    },
    {
        "id": 2,
        "start": 5.24,
        "end": 10.24,
        "jp": "なんかこうリセットされる感じですね。",
        "cn": ""
    },
    {
        "id": 3,
        "start": 10.24,
        "end": 14.8,
        "jp": "これを続けるとね、いいことがあります。",
        "cn": ""
    },
    {
        "id": 4,
        "start": 14.8,
        "end": 18.08,
        "jp": "いらいらが減るんです。",
        "cn": ""
    },
    {
        "id": 5,
        "start": 18.08,
        "end": 22.24,
        "jp": "小さいことで、起こらなくなります。",
        "cn": ""
    },
    {
        "id": 6,
        "start": 22.24,
        "end": 27.12,
        "jp": "なんていうか、心に余裕ができますね。",
        "cn": ""
    },
    {
        "id": 7,
        "start": 27.52,
        "end": 29.56,
        "jp": "私もね、変わりました。",
        "cn": ""
    },
    {
        "id": 8,
        "start": 29.56,
        "end": 33.92,
        "jp": "前より、おだやかになった気がします。",
        "cn": ""
    },
    {
        "id": 9,
        "start": 33.92,
        "end": 37.72,
        "jp": "正直、最初は続きませんでした。",
        "cn": ""
    },
    {
        "id": 10,
        "start": 37.72,
        "end": 41.56,
        "jp": "ミッカボーズってやつですね。",
        "cn": ""
    },
    {
        "id": 11,
        "start": 41.56,
        "end": 46.2,
        "jp": "ですが、3回くらいなら続けられます。",
        "cn": ""
    },
    {
        "id": 12,
        "start": 46.2,
        "end": 49.76,
        "jp": "今は毎日の週間です。",
        "cn": ""
    },
    {
        "id": 13,
        "start": 49.76,
        "end": 52.44,
        "jp": "なきゃ落ち着かないくらい。",
        "cn": ""
    },
    {
        "id": 14,
        "start": 52.44,
        "end": 55.84,
        "jp": "それくらい気持ちいいんです。",
        "cn": ""
    },
    {
        "id": 15,
        "start": 55.84,
        "end": 61.68,
        "jp": "皆さんは朝と夜、どっちがやりやすいですか?",
        "cn": ""
    },
    {
        "id": 16,
        "start": 61.68,
        "end": 64.68,
        "jp": "朝起きてからでもいいんです。",
        "cn": ""
    },
    {
        "id": 17,
        "start": 64.68,
        "end": 67.52,
        "jp": "寝る前でも大丈夫。",
        "cn": ""
    },
    {
        "id": 18,
        "start": 67.52,
        "end": 70.84,
        "jp": "自分の好きな時間でいいんです。",
        "cn": ""
    },
    {
        "id": 19,
        "start": 70.84,
        "end": 73.04,
        "jp": "かつはね、一つだけ。",
        "cn": ""
    },
    {
        "id": 20,
        "start": 73.04,
        "end": 76.6,
        "jp": "呼吸のことだけ考える。",
        "cn": ""
    },
    {
        "id": 21,
        "start": 76.6,
        "end": 80.6,
        "jp": "他のことは一旦置いておく。",
        "cn": ""
    },
    {
        "id": 22,
        "start": 80.6,
        "end": 82.84,
        "jp": "考えが浮かんでも大丈夫。",
        "cn": ""
    },
    {
        "id": 23,
        "start": 82.84,
        "end": 85.4,
        "jp": "また呼吸に戻ればいい。",
        "cn": ""
    },
    {
        "id": 24,
        "start": 85.4,
        "end": 87.44,
        "jp": "難しく考えないでね。",
        "cn": ""
    },
    {
        "id": 25,
        "start": 87.44,
        "end": 92.0,
        "jp": "まずは一回やってみてください。",
        "cn": ""
    },
    {
        "id": 26,
        "start": 92.0,
        "end": 94.84,
        "jp": "はい、次のお話です。",
        "cn": ""
    },
    {
        "id": 27,
        "start": 94.84,
        "end": 101.88,
        "jp": "皆さん、1日にどれくらいスマホを見ますか?",
        "cn": ""
    },
    {
        "id": 28,
        "start": 101.88,
        "end": 105.4,
        "jp": "気がついたら何時間も見てる。",
        "cn": ""
    },
    {
        "id": 29,
        "start": 105.4,
        "end": 108.68,
        "jp": "そんなことありませんか?",
        "cn": ""
    },
    {
        "id": 30,
        "start": 108.68,
        "end": 111.24,
        "jp": "正直、私もです。",
        "cn": ""
    },
    {
        "id": 31,
        "start": 111.24,
        "end": 116.28,
        "jp": "朝起きてすぐ、まずスマホを見ちゃいます。",
        "cn": ""
    },
    {
        "id": 32,
        "start": 116.28,
        "end": 123.56,
        "jp": "アニメもSNSも楽しい、ゲームもやめられないですよね。",
        "cn": ""
    },
    {
        "id": 33,
        "start": 123.56,
        "end": 126.8,
        "jp": "ですがここで問題があります。",
        "cn": ""
    },
    {
        "id": 34,
        "start": 126.8,
        "end": 131.48,
        "jp": "その間もね、脳は働いてるんです。",
        "cn": ""
    },
    {
        "id": 35,
        "start": 131.48,
        "end": 135.08,
        "jp": "ずっと休めていないんです。",
        "cn": ""
    },
    {
        "id": 36,
        "start": 135.08,
        "end": 141.52,
        "jp": "気づかないうちに、寝も、頭も疲れています。",
        "cn": ""
    },
    {
        "id": 37,
        "start": 141.52,
        "end": 147.6,
        "jp": "だから、玉には休ませてあげることが大切です。",
        "cn": ""
    },
    {
        "id": 38,
        "start": 147.6,
        "end": 151.84,
        "jp": "そこでデジタルデトックスです。",
        "cn": ""
    },
    {
        "id": 39,
        "start": 151.84,
        "end": 160.2,
        "jp": "デジタルデトックスっていうのは、スマホやパソコンをしばらく休むことです。",
        "cn": ""
    },
    {
        "id": 40,
        "start": 160.2,
        "end": 163.6,
        "jp": "まずは10分だけでおくけいです。",
        "cn": ""
    },
    {
        "id": 41,
        "start": 163.64,
        "end": 168.08,
        "jp": "私も寝る前のスマホをやめてみました。",
        "cn": ""
    },
    {
        "id": 42,
        "start": 168.08,
        "end": 174.08,
        "jp": "前はベットであと5分だけと思って、ずっと見ていました。",
        "cn": ""
    },
    {
        "id": 43,
        "start": 174.08,
        "end": 179.32,
        "jp": "気づいたら夜中の1時、そんな日が多かったです。",
        "cn": ""
    },
    {
        "id": 44,
        "start": 179.32,
        "end": 185.76,
        "jp": "でも寝る前の1時間、スマホを見ないようにしました。",
        "cn": ""
    },
    {
        "id": 45,
        "start": 185.76,
        "end": 190.92,
        "jp": "すると、前より眠りやすくなりました。",
        "cn": ""
    },
    {
        "id": 46,
        "start": 190.96,
        "end": 195.48,
        "jp": "朝もすっきり起きられる感じがします。",
        "cn": ""
    },
    {
        "id": 47,
        "start": 195.48,
        "end": 198.12,
        "jp": "たった10分でもいいんです。",
        "cn": ""
    },
    {
        "id": 48,
        "start": 198.12,
        "end": 205.44,
        "jp": "まずは寝る前の10分、スマホを遠くに置いてみてください。",
        "cn": ""
    },
    {
        "id": 49,
        "start": 205.44,
        "end": 210.96,
        "jp": "ベットから手が届かないところがおすすめです。",
        "cn": ""
    },
    {
        "id": 50,
        "start": 210.96,
        "end": 213.64,
        "jp": "スマホはとても便利です。",
        "cn": ""
    },
    {
        "id": 51,
        "start": 213.64,
        "end": 217.96,
        "jp": "でも休む時間も大切。",
        "cn": ""
    },
    {
        "id": 52,
        "start": 218.0,
        "end": 222.08,
        "jp": "大事なのはバランスです。",
        "cn": ""
    },
    {
        "id": 53,
        "start": 222.08,
        "end": 225.0,
        "jp": "はい、次のお話です。",
        "cn": ""
    },
    {
        "id": 54,
        "start": 225.0,
        "end": 231.28,
        "jp": "さっきはスマホを置いて脳を休める話をしました。",
        "cn": ""
    },
    {
        "id": 55,
        "start": 231.28,
        "end": 236.76,
        "jp": "今度は手を動かす話です。",
        "cn": ""
    },
    {
        "id": 56,
        "start": 236.76,
        "end": 240.92,
        "jp": "皆さんは掃除って好きですか?",
        "cn": ""
    },
    {
        "id": 57,
        "start": 240.92,
        "end": 246.64,
        "jp": "掃除が嫌いっていう人、多いんじゃないですか?",
        "cn": ""
    },
    {
        "id": 58,
        "start": 246.68,
        "end": 251.08,
        "jp": "正直私も面倒だなって思います。",
        "cn": ""
    },
    {
        "id": 59,
        "start": 251.08,
        "end": 255.64,
        "jp": "カジって本当に大変ですよね。",
        "cn": ""
    },
    {
        "id": 60,
        "start": 255.64,
        "end": 263.64,
        "jp": "カジっていうのは掃除や料理みたいな家でする仕事のことです。",
        "cn": ""
    },
    {
        "id": 61,
        "start": 263.64,
        "end": 268.32,
        "jp": "やらなきゃいけないですがやりたくない。",
        "cn": ""
    },
    {
        "id": 62,
        "start": 268.32,
        "end": 272.52,
        "jp": "カジってそういうものですよね。",
        "cn": ""
    },
    {
        "id": 63,
        "start": 272.56,
        "end": 280.0,
        "jp": "ですが実はこの掃除が心を休める時間になるんです。",
        "cn": ""
    },
    {
        "id": 64,
        "start": 280.0,
        "end": 286.8,
        "jp": "え、掃除で心が休まるのって思いましたか?",
        "cn": ""
    },
    {
        "id": 65,
        "start": 286.8,
        "end": 292.04,
        "jp": "前の考え方を使うと変わるんですよ。",
        "cn": ""
    },
    {
        "id": 66,
        "start": 292.04,
        "end": 299.0,
        "jp": "お手らのお坊さんはね、掃除をとても大切にするそうです。",
        "cn": ""
    },
    {
        "id": 67,
        "start": 299.04,
        "end": 304.32,
        "jp": "掃除はただ部屋を綺麗にするだけじゃないんです。",
        "cn": ""
    },
    {
        "id": 68,
        "start": 304.32,
        "end": 309.12,
        "jp": "心の中のほこりも一緒に綺麗にする。",
        "cn": ""
    },
    {
        "id": 69,
        "start": 309.12,
        "end": 313.08,
        "jp": "そんな考え方があるんです。",
        "cn": ""
    },
    {
        "id": 70,
        "start": 313.08,
        "end": 318.72,
        "jp": "だから掃除をするときは予計なことを考えない。",
        "cn": ""
    },
    {
        "id": 71,
        "start": 318.72,
        "end": 322.28,
        "jp": "目の前の掃除だけをする。",
        "cn": ""
    },
    {
        "id": 72,
        "start": 322.28,
        "end": 327.2,
        "jp": "これも全の主要の一つなんですね。",
        "cn": ""
    },
    {
        "id": 73,
        "start": 327.24,
        "end": 329.44,
        "jp": "私たちもできます。",
        "cn": ""
