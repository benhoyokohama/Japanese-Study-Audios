[
    {
        "id": 1,
        "start": 0.0,
        "end": 4.0,
        "jp": "仕事もフルタイムでしています。",
        "cn": ""
    },
    {
        "id": 2,
        "start": 4.0,
        "end": 9.0,
        "jp": "そんな時こそ公園に行きます。",
        "cn": ""
    },
    {
        "id": 3,
        "start": 9.0,
        "end": 15.0,
        "jp": "ベンチに座ってパッタ十分だけ緑を見ます。",
        "cn": ""
    },
    {
        "id": 4,
        "start": 15.0,
        "end": 19.0,
        "jp": "すると心がほっとします。",
        "cn": ""
    },
    {
        "id": 5,
        "start": 19.0,
        "end": 22.0,
        "jp": "みなさんも今日やってみませんか?",
        "cn": ""
    },
    {
        "id": 6,
        "start": 22.0,
        "end": 26.0,
        "jp": "家の近くの公園に行ってみてください。",
        "cn": ""
    },
    {
        "id": 7,
        "start": 27.0,
        "end": 31.0,
        "jp": "5分でも10分でもいいんですよ。",
        "cn": ""
    },
    {
        "id": 8,
        "start": 32.0,
        "end": 37.0,
        "jp": "で、次はね、心の中の話です。",
        "cn": ""
    },
    {
        "id": 9,
        "start": 37.0,
        "end": 42.0,
        "jp": "全て聞いたことありますか?",
        "cn": ""
    },
    {
        "id": 10,
        "start": 42.0,
        "end": 48.0,
        "jp": "全ていうのは、今していることに集中します。",
        "cn": ""
    },
    {
        "id": 11,
        "start": 48.0,
        "end": 53.0,
        "jp": "そして目の前のことを見つめる。",
        "cn": ""
    },
    {
        "id": 12,
        "start": 53.0,
        "end": 58.0,
        "jp": "そんな日本の古い考え方の一つです。",
        "cn": ""
    },
    {
        "id": 13,
        "start": 58.0,
        "end": 61.0,
        "jp": "なんか難しいそうですよね。",
        "cn": ""
    },
    {
        "id": 14,
        "start": 61.0,
        "end": 66.0,
        "jp": "ですが、実はシンプルなんです。",
        "cn": ""
    },
    {
        "id": 15,
        "start": 66.0,
        "end": 69.0,
        "jp": "みなさんに質問です。",
        "cn": ""
    },
    {
        "id": 16,
        "start": 69.0,
        "end": 73.0,
        "jp": "昔の失敗を思い出すことありませんか?",
        "cn": ""
    },
    {
        "id": 17,
        "start": 73.0,
        "end": 77.0,
        "jp": "あとは明日の心配とかね。",
        "cn": ""
    },
    {
        "id": 18,
        "start": 77.0,
        "end": 79.0,
        "jp": "失敗したらどうしよう。",
        "cn": ""
    },
    {
        "id": 19,
        "start": 80.0,
        "end": 85.0,
        "jp": "こんな風に心配で眠れない夜もありますよね。",
        "cn": ""
    },
    {
        "id": 20,
        "start": 85.0,
        "end": 88.0,
        "jp": "私もよくあります。",
        "cn": ""
    },
    {
        "id": 21,
        "start": 88.0,
        "end": 93.0,
        "jp": "夜、子供が寝た後にいろいろ考えちゃうんです。",
        "cn": ""
    },
    {
        "id": 22,
        "start": 93.0,
        "end": 96.0,
        "jp": "明日の準備大丈夫かな?",
        "cn": ""
    },
    {
        "id": 23,
        "start": 96.0,
        "end": 100.0,
        "jp": "将来学校同士をかな?",
        "cn": ""
    },
    {
        "id": 24,
        "start": 100.0,
        "end": 104.0,
        "jp": "考えても仕方ないのにね。",
        "cn": ""
    },
    {
        "id": 25,
        "start": 104.0,
        "end": 107.0,
        "jp": "それでも止まらないんです。",
        "cn": ""
    },
    {
        "id": 26,
        "start": 107.0,
        "end": 111.0,
        "jp": "朝まで眠れない日もあります。",
        "cn": ""
    },
    {
        "id": 27,
        "start": 111.0,
        "end": 116.0,
        "jp": "これだと頭が全然やすまらないですよね。",
        "cn": ""
    },
    {
        "id": 28,
        "start": 116.0,
        "end": 123.0,
        "jp": "例えると頭の中がね、スマホと同じなんです。",
        "cn": ""
    },
    {
        "id": 29,
        "start": 123.0,
        "end": 130.0,
        "jp": "アプリを開きすぎると、スマホが重くなりますよね。",
        "cn": ""
    },
    {
        "id": 30,
        "start": 130.0,
        "end": 135.0,
        "jp": "一つずつ閉じると軽くなります。",
        "cn": ""
    },
    {
        "id": 31,
        "start": 135.0,
        "end": 139.0,
        "jp": "頭の中もちょっと似ているんです。",
        "cn": ""
    },
    {
        "id": 32,
        "start": 139.0,
        "end": 143.0,
        "jp": "いろいろ考えすぎると疲れてしまいます。",
        "cn": ""
    },
    {
        "id": 33,
        "start": 143.0,
        "end": 147.0,
        "jp": "だから、脳も休みたいんですよね。",
        "cn": ""
    },
    {
        "id": 34,
        "start": 147.0,
        "end": 154.0,
        "jp": "そこで全然は今に意識を向ける練習をします。",
        "cn": ""
    },
    {
        "id": 35,
        "start": 154.0,
        "end": 160.0,
        "jp": "昔のことや明日のことをちょっとだけ横に置いてみる。",
        "cn": ""
    },
    {
        "id": 36,
        "start": 161.0,
        "end": 165.0,
        "jp": "そして今、目の前にあることだけを見る。",
        "cn": ""
    },
    {
        "id": 37,
        "start": 165.0,
        "end": 168.0,
        "jp": "それだけなんです。",
        "cn": ""
    },
    {
        "id": 38,
        "start": 168.0,
        "end": 172.0,
        "jp": "実は簡単な練習があります。",
        "cn": ""
    },
    {
        "id": 39,
        "start": 172.0,
        "end": 176.0,
        "jp": "例えば、ご飯を食べる時、",
        "cn": ""
    },
    {
        "id": 40,
        "start": 176.0,
        "end": 181.0,
        "jp": "いつもはいろいろ考えながら食べていますよね。",
        "cn": ""
    },
    {
        "id": 41,
        "start": 181.0,
        "end": 184.0,
        "jp": "スマホを見ながら食べたりね。",
        "cn": ""
    },
    {
        "id": 42,
        "start": 184.0,
        "end": 189.0,
        "jp": "でも一度だけご飯だけに集中してみてください。",
        "cn": ""
    },
    {
        "id": 43,
        "start": 190.0,
        "end": 195.0,
        "jp": "料理の味、香り、温かさ、",
        "cn": ""
    },
    {
        "id": 44,
        "start": 195.0,
        "end": 199.0,
        "jp": "一つ一つゆっくり感じてみるんです。",
        "cn": ""
    },
    {
        "id": 45,
        "start": 199.0,
        "end": 204.0,
        "jp": "あ、美味しいなぁ。それだけでいいんです。",
        "cn": ""
    },
    {
        "id": 46,
        "start": 204.0,
        "end": 207.0,
        "jp": "食べることだけを考える。",
        "cn": ""
    },
    {
        "id": 47,
        "start": 207.0,
        "end": 214.0,
        "jp": "すると頭の中のいろいろな考えが少し静かになります。",
        "cn": ""
    },
    {
        "id": 48,
        "start": 215.0,
        "end": 219.0,
        "jp": "気持ちもだんだん落ち着いてきます。",
        "cn": ""
    },
    {
        "id": 49,
        "start": 219.0,
        "end": 226.0,
        "jp": "そして、いつものご飯がもっと美味しく感じられるかもしれません。",
        "cn": ""
    },
    {
        "id": 50,
        "start": 226.0,
        "end": 232.0,
        "jp": "これが今に集中する練習なんです。",
        "cn": ""
    },
    {
        "id": 51,
        "start": 232.0,
        "end": 235.0,
        "jp": "意外と難しいんですよ。",
        "cn": ""
    },
    {
        "id": 52,
        "start": 235.0,
        "end": 238.0,
        "jp": "やってみてくださいね。",
        "cn": ""
    },
    {
        "id": 53,
        "start": 239.0,
        "end": 243.0,
        "jp": "次は、マインドフルネスについてです。",
        "cn": ""
    },
    {
        "id": 54,
        "start": 243.0,
        "end": 247.0,
        "jp": "アメリカでも大人気な言葉なんです。",
        "cn": ""
    },
    {
        "id": 55,
        "start": 247.0,
        "end": 251.0,
        "jp": "有名な会社も取り入れています。",
        "cn": ""
    },
    {
        "id": 56,
        "start": 251.0,
        "end": 258.0,
        "jp": "マインドフルネスは今の自分の気持ちや体に気づくことです。",
        "cn": ""
    },
    {
        "id": 57,
        "start": 258.0,
        "end": 261.0,
        "jp": "やり方はね、とっても簡単。",
        "cn": ""
    },
    {
        "id": 58,
        "start": 261.0,
        "end": 265.0,
        "jp": "目を閉じて、息を吸う。",
        "cn": ""
    },
    {
        "id": 59,
        "start": 265.0,
        "end": 270.0,
        "jp": "鼻からね、スーッと空気が入ってきます。",
        "cn": ""
    },
    {
        "id": 60,
        "start": 270.0,
        "end": 274.0,
        "jp": "お腹が吹くらむのを感じます。",
        "cn": ""
    },
    {
        "id": 61,
        "start": 274.0,
        "end": 279.0,
        "jp": "で、口からふーっと吐きます。",
        "cn": ""
    },
    {
        "id": 62,
        "start": 279.0,
        "end": 283.0,
        "jp": "肩の力がスーッと抜けます。",
        "cn": ""
    },
    {
        "id": 63,
        "start": 283.0,
        "end": 288.0,
        "jp": "これを3回くらい繰り返します。",
        "cn": ""
    },
    {
        "id": 64,
        "start": 288.0,
        "end": 292.0,
        "jp": "するとだんだん体が暖かくなります。",
        "cn": ""
    },
    {
        "id": 65,
        "start": 293.0,
        "end": 296.0,
        "jp": "心臓の音も聞こえます。",
        "cn": ""
    },
    {
        "id": 66,
        "start": 296.0,
        "end": 300.0,
        "jp": "なんかこう自分に戻る感じ。",
        "cn": ""
    }
]