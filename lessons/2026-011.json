[
    {
        "id": 1,
        "start": 0.0,
        "end": 6.98,
        "jp": "お皿を洗う時、他のことは考えないんです。",
        "cn": ""
    },
    {
        "id": 2,
        "start": 6.98,
        "end": 10.94,
        "jp": "お皿を洗う時、水の音を聞くんです。",
        "cn": ""
    },
    {
        "id": 3,
        "start": 10.94,
        "end": 15.06,
        "jp": "ざーっと、水が流れる音。",
        "cn": ""
    },
    {
        "id": 4,
        "start": 15.06,
        "end": 19.52,
        "jp": "それから手に当たるお湯の当たかさ。",
        "cn": ""
    },
    {
        "id": 5,
        "start": 19.52,
        "end": 23.72,
        "jp": "なんかこう、人割、当たかいんですよ。",
        "cn": ""
    },
    {
        "id": 6,
        "start": 23.72,
        "end": 27.94,
        "jp": "その当たかさだけを感じてみます。",
        "cn": ""
    },
    {
        "id": 7,
        "start": 27.94,
        "end": 32.06,
        "jp": "そうするとどうなると思いますか?",
        "cn": ""
    },
    {
        "id": 8,
        "start": 32.06,
        "end": 38.26,
        "jp": "頭の中が少しずつ静かになります。",
        "cn": ""
    },
    {
        "id": 9,
        "start": 38.26,
        "end": 41.06,
        "jp": "明日の仕事どうしよう?",
        "cn": ""
    },
    {
        "id": 10,
        "start": 41.06,
        "end": 48.1,
        "jp": "あのメール返さないと、そんなことを一旦忘れられるんです。",
        "cn": ""
    },
    {
        "id": 11,
        "start": 48.1,
        "end": 54.38,
        "jp": "そして、洗い終わった時、お皿も綺麗になっています。",
        "cn": ""
    },
    {
        "id": 12,
        "start": 54.38,
        "end": 61.62,
        "jp": "心も何なかすっきり、やって良かったなぁと思います。",
        "cn": ""
    },
    {
        "id": 13,
        "start": 61.62,
        "end": 70.66,
        "jp": "そうじって、部屋だけじゃなくて、心も少し綺麗にしてくれるんですね。",
        "cn": ""
    },
    {
        "id": 14,
        "start": 70.66,
        "end": 74.22,
        "jp": "はい、次のお話です。",
        "cn": ""
    },
    {
        "id": 15,
        "start": 74.22,
        "end": 78.7,
        "jp": "皆さんはお茶は好きですか?",
        "cn": ""
    },
    {
        "id": 16,
        "start": 78.7,
        "end": 82.62,
        "jp": "毎日何か飲み物を飲みますよね。",
        "cn": ""
    },
    {
        "id": 17,
        "start": 82.62,
        "end": 86.1,
        "jp": "コーヒーとか、コーチャとか。",
        "cn": ""
    },
    {
        "id": 18,
        "start": 86.1,
        "end": 90.66,
        "jp": "ですがどんな風に飲んでいますか?",
        "cn": ""
    },
    {
        "id": 19,
        "start": 90.66,
        "end": 94.54,
        "jp": "忙しいとパッと飲んで、終わり。",
        "cn": ""
    },
    {
        "id": 20,
        "start": 94.54,
        "end": 97.1,
        "jp": "こういうことないですか?",
        "cn": ""
    },
    {
        "id": 21,
        "start": 97.1,
        "end": 100.58,
        "jp": "ここで日本の文化のお話です。",
        "cn": ""
    },
    {
        "id": 22,
        "start": 100.58,
        "end": 106.82,
        "jp": "日本には昔からお茶をゆっくり味わう文化があります。",
        "cn": ""
    },
    {
        "id": 23,
        "start": 106.82,
        "end": 111.3,
        "jp": "皆さん、待っちゃって聞いたことありますよね。",
        "cn": ""
    },
    {
        "id": 24,
        "start": 111.34,
        "end": 117.26,
        "jp": "待っちゃって言うのは、緑色の粉のお茶のことですね。",
        "cn": ""
    },
    {
        "id": 25,
        "start": 117.26,
        "end": 121.98,
        "jp": "実はこれ、マインドフルネスととても似ているんです。",
        "cn": ""
    },
    {
        "id": 26,
        "start": 121.98,
        "end": 127.94,
        "jp": "え、お茶とマインドフルネス、って思いましたか?",
        "cn": ""
    },
    {
        "id": 27,
        "start": 127.94,
        "end": 130.62,
        "jp": "飲むことだけに集中する。",
        "cn": ""
    },
    {
        "id": 28,
        "start": 130.62,
        "end": 134.02,
        "jp": "それが一緒なんですね。",
        "cn": ""
    },
    {
        "id": 29,
        "start": 134.02,
        "end": 139.1,
        "jp": "日本には、砂糖っていう文化があります。",
        "cn": ""
    },
    {
        "id": 30,
        "start": 139.14,
        "end": 144.9,
        "jp": "お茶を入れる、その動きに集中するんです。",
        "cn": ""
    },
    {
        "id": 31,
        "start": 144.9,
        "end": 150.3,
        "jp": "一つ一つ、丁寧にやるんですよね。",
        "cn": ""
    },
    {
        "id": 32,
        "start": 150.3,
        "end": 155.54,
        "jp": "それは今に集中するためなんです。",
        "cn": ""
    },
    {
        "id": 33,
        "start": 155.54,
        "end": 160.18,
        "jp": "お茶を入れる時は、お湯の音を聞く。",
        "cn": ""
    },
    {
        "id": 34,
        "start": 160.18,
        "end": 163.78,
        "jp": "お茶の香りを感じる。",
        "cn": ""
    },
    {
        "id": 35,
        "start": 163.78,
        "end": 166.98,
        "jp": "そしてゆっくり味わう。",
        "cn": ""
    },
    {
        "id": 36,
        "start": 167.02,
        "end": 171.82,
        "jp": "その時間は他のことを考えません。",
        "cn": ""
    },
    {
        "id": 37,
        "start": 171.82,
        "end": 177.7,
        "jp": "仕事のことも、明日のことも一旦忘れます。",
        "cn": ""
    },
    {
        "id": 38,
        "start": 177.7,
        "end": 184.18,
        "jp": "目の前のお茶だけを見て、感じて楽しみます。",
        "cn": ""
    },
    {
        "id": 39,
        "start": 184.18,
        "end": 190.02,
        "jp": "これもマインドフルネスと同じなんですね。",
        "cn": ""
    },
    {
        "id": 40,
        "start": 190.02,
        "end": 195.82,
        "jp": "実は、砂糖は全度も深いつながりがあります。",
        "cn": ""
    },
    {
        "id": 41,
        "start": 195.86,
        "end": 200.7,
        "jp": "砂糖で有名な人が、線の理球です。",
        "cn": ""
    },
    {
        "id": 42,
        "start": 200.7,
        "end": 207.62,
        "jp": "線の理球は、砂糖の大切な考え方を広めた人です。",
        "cn": ""
    },
    {
        "id": 43,
        "start": 207.62,
        "end": 211.74,
        "jp": "今、この時間を大切にする。",
        "cn": ""
    },
    {
        "id": 44,
        "start": 211.74,
        "end": 216.54,
        "jp": "そんな考え方が、砂糖にはあります。",
        "cn": ""
    },
    {
        "id": 45,
        "start": 216.54,
        "end": 224.94,
        "jp": "だから、砂糖も全部、今に集中するというところが良く似ているんですね。",
        "cn": ""
    },
    {
        "id": 46,
        "start": 225.14,
        "end": 230.82,
        "jp": "一口、一口を大切に味わいます。",
        "cn": ""
    },
    {
        "id": 47,
        "start": 230.82,
        "end": 232.74,
        "jp": "パッタ5分です。",
        "cn": ""
    },
    {
        "id": 48,
        "start": 232.74,
        "end": 240.82,
        "jp": "こういうよう、一杯の向くらいの時間ですが、心がすっと落ち着くんです。",
        "cn": ""
    },
    {
        "id": 49,
        "start": 240.82,
        "end": 246.1,
        "jp": "なんていうか、時間がゆっくり流れる感じ。",
        "cn": ""
    },
    {
        "id": 50,
        "start": 246.1,
        "end": 252.18,
        "jp": "昔はね、お茶は、時間の無駄と思ってました。",
        "cn": ""
    },
    {
        "id": 51,
        "start": 252.22,
        "end": 256.3,
        "jp": "ゆっくりする時間がもったいない気がして、",
        "cn": ""
    },
    {
        "id": 52,
        "start": 256.3,
        "end": 260.82,
        "jp": "ですが、今は考えが変わりました。",
        "cn": ""
    },
    {
        "id": 53,
        "start": 260.82,
        "end": 265.66,
        "jp": "ゆっくりするのも大事な時間なんですね。",
        "cn": ""
    },
    {
        "id": 54,
        "start": 265.66,
        "end": 271.5,
        "jp": "飲み物を味わう時間が、心の休みになるんですね。",
        "cn": ""
    },
    {
        "id": 55,
        "start": 271.5,
        "end": 275.98,
        "jp": "で、今度は体を動かす話です。",
        "cn": ""
    },
    {
        "id": 56,
        "start": 275.98,
        "end": 281.7,
        "jp": "マインドフルネスは、歩きながらでもできるんですよ。",
        "cn": ""
    },
    {
        "id": 57,
        "start": 281.74,
        "end": 285.1,
        "jp": "歩くだけって思いますよね。",
        "cn": ""
    },
    {
        "id": 58,
        "start": 285.1,
        "end": 289.58,
        "jp": "そうなんです。とっても簡単です。",
        "cn": ""
    },
    {
        "id": 59,
        "start": 289.58,
        "end": 294.7,
        "jp": "皆さん、歩きながら色々考えていませんか?",
        "cn": ""
    },
    {
        "id": 60,
        "start": 294.7,
        "end": 299.22,
        "jp": "あれかわなきゃ、あの仕事をどうしよう。",
        "cn": ""
    },
    {
        "id": 61,
        "start": 299.22,
        "end": 304.06,
        "jp": "頭の中がいつも忙しいんですよね。",
        "cn": ""
    },
    {
        "id": 62,
        "start": 304.06,
        "end": 310.9,
        "jp": "そこで、歩く時は、足の裏に集中してみます。",
        "cn": ""
    },
    {
        "id": 63,
        "start": 310.94,
        "end": 316.38,
        "jp": "かかとがつく、次につま先がつく。",
        "cn": ""
    },
    {
        "id": 64,
        "start": 316.38,
        "end": 320.42,
        "jp": "その感覚を感じるだけです。",
        "cn": ""
    },
    {
        "id": 65,
        "start": 320.42,
        "end": 324.02,
        "jp": "そして耳も使ってみます。",
        "cn": ""
    },
    {
        "id": 66,
        "start": 324.02,
        "end": 328.22,
        "jp": "風の音、取り残え。",
        "cn": ""
    },
    {
        "id": 67,
        "start": 328.22,
        "end": 331.3,
        "jp": "あ、取りが泣いてる。",
        "cn": ""
    },
    {
        "id": 68,
        "start": 331.3,
        "end": 335.7,
        "jp": "それに気づくだけでいいんです。",
        "cn": ""
    },
    {
        "id": 69,
        "start": 335.74,
        "end": 341.22,
        "jp": "私は前は、スマホを見ながら歩いていました。",
        "cn": ""
    },
    {
        "id": 70,
        "start": 341.22,
        "end": 346.14,
        "jp": "でもある日、スマホをカバンに入れてみました。",
        "cn": ""
    },
    {
        "id": 71,
        "start": 346.14,
        "end": 352.22,
        "jp": "そして、足の裏と風だけを感じてみたんです。",
        "cn": ""
    },
    {
        "id": 72,
        "start": 352.22,
        "end": 358.66,
        "jp": "すると、いつもの道なのに、いろいろなことに気づきました。",
        "cn": ""
    },
    {
        "id": 73,
        "start": 358.66,
        "end": 364.38,
        "jp": "ほっぺに当たる風、道の小さな花。",
        "cn": ""
    },
    {
        "id": 74,
        "start": 364.42,
        "end": 366.5,
        "jp": "取り残え。",
        "cn": ""
    },
    {
        "id": 75,
        "start": 366.5,
        "end": 370.22,
        "jp": "可愛いお店の感覚。",
        "cn": ""
    },
    {
        "id": 76,
        "start": 370.22,
        "end": 376.38,
        "jp": "毎日歩いている道なのに、初めて気づいたんです。",
        "cn": ""
    },
    {
        "id": 77,
        "start": 376.38,
        "end": 380.86,
        "jp": "何だか心もすっきりしました。",
        "cn": ""
    },
    {
        "id": 78,
        "start": 380.86,
        "end": 386.3,
        "jp": "いつもの道が宝探しみたいに感じました。",
        "cn": ""
    },
    {
        "id": 79,
        "start": 386.3,
        "end": 390.9,
        "jp": "これが歩く、毎度フルネスです。",
        "cn": ""
    },
    {
        "id": 80,
        "start": 390.9,
        "end": 394.3,
        "jp": "特別な場所は入りません。",
        "cn": ""
    },
    {
        "id": 81,
        "start": 394.3,
        "end": 399.06,
        "jp": "通勤でも、3歩でも大丈夫。",
        "cn": ""
    },
    {
        "id": 82,
        "start": 399.06,
        "end": 404.5,
        "jp": "今日の帰り道、スマホをしまってみませんか?",
        "cn": ""
    },
    {
        "id": 83,
        "start": 404.5,
        "end": 412.14,
        "jp": "足の裏や、風の音を感じながらゆっくり歩いてみてください。",
        "cn": ""
    },
    {
        "id": 84,
        "start": 412.14,
        "end": 417.98,
        "jp": "きっと、いつもの道が少し違ってみえると思います。",
        "cn": ""
    },
    {
        "id": 85,
        "start": 418.98,
        "end": 422.62,
        "jp": "最後のお話です。",
        "cn": ""
    },
    {
        "id": 86,
        "start": 422.62,
        "end": 426.62,
        "jp": "今日はたくさん紹介しましたね。",
        "cn": ""
    },
    {
        "id": 87,
        "start": 426.62,
        "end": 431.62,
        "jp": "心臨力は自然を感じること。",
        "cn": ""
    },
    {
        "id": 88,
        "start": 431.62,
        "end": 435.98,
        "jp": "全は今に集中すること。",
        "cn": ""
    },
    {
        "id": 89,
        "start": 435.98,
        "end": 442.46,
        "jp": "毎度フルネスは、呼吸や体の状態に気づくこと。",
        "cn": ""
    },
    {
        "id": 90,
        "start": 442.46,
        "end": 448.1,
        "jp": "デジタルデトックスは、スマホから少し離れること。",
        "cn": ""
    },
    {
        "id": 91,
        "start": 448.1,
        "end": 453.58,
        "jp": "そうじだけに集中して心を落ち着かせること。",
        "cn": ""
    },
    {
        "id": 92,
        "start": 453.58,
        "end": 459.38,
        "jp": "お茶の音、味などゆっくり味わうこと。",
        "cn": ""
    },
    {
        "id": 93,
        "start": 459.38,
        "end": 466.98,
        "jp": "歩きながら、足の感覚や周りの音を感じること。",
        "cn": ""
    },
    {
        "id": 94,
        "start": 466.98,
        "end": 472.3,
        "jp": "共通しているのは今です。",
        "cn": ""
    },
    {
        "id": 95,
        "start": 472.3,
        "end": 477.54,
        "jp": "過去のことを考えすぎたり、未来を心配したり、",
        "cn": ""
    },
    {
        "id": 96,
        "start": 477.54,
        "end": 482.66,
        "jp": "スマホを見たりしていると頭が忙しくなります。",
        "cn": ""
    },
    {
        "id": 97,
        "start": 482.66,
        "end": 488.38,
        "jp": "だから、今、ここにあるものを感じる。",
        "cn": ""
    },
    {
        "id": 98,
        "start": 488.38,
        "end": 493.7,
        "jp": "それだけで少し心を休めることができる。",
        "cn": ""
    },
    {
        "id": 99,
        "start": 493.7,
        "end": 499.74,
        "jp": "でも大切なことは完璧を目指さないことです。",
        "cn": ""
    },
    {
        "id": 100,
        "start": 499.74,
        "end": 504.82,
        "jp": "完璧っていうのは、100点万点のことですね。",
        "cn": ""
    },
    {
        "id": 101,
        "start": 504.82,
        "end": 508.94,
        "jp": "一つも間違いがないみたいな。",
        "cn": ""
    },
    {
        "id": 102,
        "start": 508.94,
        "end": 512.18,
        "jp": "ですが、そんなの無理ですよね。",
        "cn": ""
    },
    {
        "id": 103,
        "start": 512.18,
        "end": 516.54,
        "jp": "完璧を目指すと、ちょっと苦しいんです。",
        "cn": ""
    },
    {
        "id": 104,
        "start": 516.54,
        "end": 519.06,
        "jp": "ちゃんとやらなきゃ、って思う。",
        "cn": ""
    },
    {
        "id": 105,
        "start": 519.06,
        "end": 522.54,
        "jp": "よし、毎日やるぞって決める。",
        "cn": ""
    },
    {
        "id": 106,
        "start": 522.58,
        "end": 525.9,
        "jp": "ですが、みっかりやめちゃ、",
        "cn": ""
    },
    {
        "id": 107,
        "start": 525.9,
        "end": 530.3,
        "jp": "みっかぼうずって言葉もありますよね。",
        "cn": ""
    },
    {
        "id": 108,
        "start": 530.3,
        "end": 533.62,
        "jp": "正直私もよくあります。",
        "cn": ""
    },
    {
        "id": 109,
        "start": 533.62,
        "end": 536.58,
        "jp": "実はね、それでいいんです。",
        "cn": ""
    },
    {
        "id": 110,
        "start": 536.58,
        "end": 540.26,
        "jp": "毎日できなくても大丈夫。",
        "cn": ""
    },
    {
        "id": 111,
        "start": 540.26,
        "end": 546.22,
        "jp": "今日は疲れた休もう、それでOKです。",
        "cn": ""
    },
    {
        "id": 112,
        "start": 546.22,
        "end": 549.94,
        "jp": "頑張りすぎると続かないんですよね。",
        "cn": ""
    },
    {
        "id": 113,
        "start": 549.98,
        "end": 553.94,
        "jp": "それが普通なんですよね。",
        "cn": ""
    },
    {
        "id": 114,
        "start": 553.94,
        "end": 557.62,
        "jp": "一日休んでも、また始めればいい。",
        "cn": ""
    },
    {
        "id": 115,
        "start": 557.62,
        "end": 561.82,
        "jp": "休むのも大事な時間なんです。",
        "cn": ""
    },
    {
        "id": 116,
        "start": 561.82,
        "end": 566.46,
        "jp": "疲れた日は、公園で緑を見る。",
        "cn": ""
    },
    {
        "id": 117,
        "start": 566.46,
        "end": 570.34,
        "jp": "忙しい朝は、3分だけ深呼吸。",
        "cn": ""
    },
    {
        "id": 118,
        "start": 570.34,
        "end": 575.42,
        "jp": "心臨よくでも、お茶でも、なんでもいいんです。",
        "cn": ""
    },
    {
        "id": 119,
        "start": 575.42,
        "end": 579.06,
        "jp": "自分のペースでいいんですよ。",
        "cn": ""
    },
    {
        "id": 120,
        "start": 579.1,
