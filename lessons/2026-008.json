[
    {
        "id": 1,
        "start": 0.0,
        "end": 8.84,
        "jp": "自然人力というのは、盛りや公園を歩いて自然を感じることです。",
        "cn": ""
    },
    {
        "id": 2,
        "start": 8.84,
        "end": 11.84,
        "jp": "ただそれだけなんです。",
        "cn": ""
    },
    {
        "id": 3,
        "start": 11.84,
        "end": 15.24,
        "jp": "誰でもできますよね。",
        "cn": ""
    },
    {
        "id": 4,
        "start": 15.24,
        "end": 24.32,
        "jp": "実は、新人力という本が、アメリカでたくさん売れたそうです。",
        "cn": ""
    },
    {
        "id": 5,
        "start": 24.32,
        "end": 31.64,
        "jp": "英語でも新人力と日本語のまま使われています。",
        "cn": ""
    },
    {
        "id": 6,
        "start": 31.64,
        "end": 40.04,
        "jp": "日本では昔からあることが、今、海外でも人気になっているんですね。",
        "cn": ""
    },
    {
        "id": 7,
        "start": 40.04,
        "end": 42.72,
        "jp": "面白いですよね。",
        "cn": ""
    },
    {
        "id": 8,
        "start": 42.72,
        "end": 47.48,
        "jp": "日本人の私もびっくりしました。",
        "cn": ""
    },
    {
        "id": 9,
        "start": 47.48,
        "end": 53.2,
        "jp": "身近すぎて、今まであまり気にしていなかったんです。",
        "cn": ""
    },
    {
        "id": 10,
        "start": 53.2,
        "end": 58.12,
        "jp": "なので、今回調べてみました。",
        "cn": ""
    },
    {
        "id": 11,
        "start": 58.12,
        "end": 63.08,
        "jp": "新人力は何がいいのでしょうか。",
        "cn": ""
    },
    {
        "id": 12,
        "start": 63.08,
        "end": 70.24,
        "jp": "まず、新人力をすると、ストレスが少なくなります。",
        "cn": ""
    },
    {
        "id": 13,
        "start": 70.24,
        "end": 74.6,
        "jp": "それから心が落ち着きます。",
        "cn": ""
    },
    {
        "id": 14,
        "start": 74.6,
        "end": 77.44,
        "jp": "想像してみてください。",
        "cn": ""
    },
    {
        "id": 15,
        "start": 77.44,
        "end": 84.52,
        "jp": "太陽の光が、葉っぱの間からキラキラしています。",
        "cn": ""
    },
    {
        "id": 16,
        "start": 84.52,
        "end": 88.6,
        "jp": "キラ、土のいい香りもします。",
        "cn": ""
    },
    {
        "id": 17,
        "start": 88.6,
        "end": 92.56,
        "jp": "鳥の声も聞こえてきます。",
        "cn": ""
    },
    {
        "id": 18,
        "start": 92.56,
        "end": 98.12,
        "jp": "想像するだけでも気持ちがいいですよね。",
        "cn": ""
    },
    {
        "id": 19,
        "start": 98.16,
        "end": 105.8,
        "jp": "昨日香りには、ストレスを少なくする働きがあるそうです。",
        "cn": ""
    },
    {
        "id": 20,
        "start": 105.8,
        "end": 110.12,
        "jp": "それから体もリラックスします。",
        "cn": ""
    },
    {
        "id": 21,
        "start": 110.12,
        "end": 117.36,
        "jp": "すると、血圧や心配も落ち着きます。",
        "cn": ""
    },
    {
        "id": 22,
        "start": 117.36,
        "end": 123.48,
        "jp": "このように気持ちがいいと思うだけではありません。",
        "cn": ""
    },
    {
        "id": 23,
        "start": 123.48,
        "end": 130.6,
        "jp": "体にもいい変化があることが研究でわかっているんです。",
        "cn": ""
    },
    {
        "id": 24,
        "start": 130.6,
        "end": 139.6,
        "jp": "私たち人間は長い間、自然と一緒に生活してきました。",
        "cn": ""
    },
    {
        "id": 25,
        "start": 139.6,
        "end": 143.8,
        "jp": "今はビルが多いですよね。",
        "cn": ""
    },
    {
        "id": 26,
        "start": 143.84,
        "end": 154.72,
        "jp": "でも人間の700万年の歴史のほとんどは自然の中で生活してきました。",
        "cn": ""
    },
    {
        "id": 27,
        "start": 154.72,
        "end": 163.36,
        "jp": "だから自然の中にいると体が自然にリラックスするんですね。",
        "cn": ""
    },
    {
        "id": 28,
        "start": 163.36,
        "end": 166.12,
        "jp": "面白いですよね。",
        "cn": ""
    },
    {
        "id": 29,
        "start": 166.12,
        "end": 169.96,
        "jp": "私もなるほどと思いました。",
        "cn": ""
    },
    {
        "id": 30,
        "start": 170.0,
        "end": 175.32,
        "jp": "私も実は心臨よくおよくします。",
        "cn": ""
    },
    {
        "id": 31,
        "start": 175.32,
